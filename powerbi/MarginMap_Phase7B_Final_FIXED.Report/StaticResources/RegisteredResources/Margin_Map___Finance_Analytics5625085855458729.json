              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#23272E"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#EFF2F7"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
